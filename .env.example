# Next.js Frontend
NEXT_PUBLIC_APP_NAME=Harvest Tracker
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Spring Boot Backend & Database
PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/harvest_tracker?options=-c%20timezone=UTC
SPRING_DATASOURCE_USERNAME=harvest_user
SPRING_DATASOURCE_PASSWORD=harvest_password
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Container
POSTGRES_DB=harvest_tracker
POSTGRES_USER=harvest_user
POSTGRES_PASSWORD=harvest_password
DB_HOST=localhost
DB_PORT=5432
